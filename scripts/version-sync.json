{
  "groups": [
    {
      "name": "Playwright",
      "compare": "exact",
      "sources": [
        {
          "path": "web/package-lock.json",
          "json": [
            "packages",
            "node_modules/@playwright/test",
            "version"
          ]
        },
        {
          "path": "web/package-lock.json",
          "json": [
            "packages",
            "node_modules/playwright",
            "version"
          ]
        },
        {
          "path": "web/package-lock.json",
          "json": [
            "packages",
            "node_modules/playwright-core",
            "version"
          ]
        },
        {
          "path": "web/Dockerfile.e2e",
          "regex": "playwright:v([0-9][0-9.]*)"
        }
      ]
    },
    {
      "name": "Node",
      "compare": "major",
      "sources": [
        {
          "path": ".github/workflows/ci.yml",
          "regex": "node-version:\\s*['\"]?([0-9][0-9.]*)"
        },
        {
          "path": "web/Dockerfile",
          "regex": "^FROM node:([0-9][0-9.]*)"
        },
        {
          "path": "web/package-lock.json",
          "json": [
            "packages",
            "node_modules/@types/node",
            "version"
          ]
        }
      ]
    },
