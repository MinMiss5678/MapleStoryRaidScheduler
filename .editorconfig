# EditorConfig — 專案格式標準（CI 以 dotnet format --verify-no-changes 檢查）
# 刻意保持最小：只定縮排 / 尾端空白 / 檔案結尾換行，不強加命名或風格重寫，避免大量 churn。
# 不設 end_of_line，避免 CRLF/LF 大量轉換（交給 git 處理）。
root = true

[*]
indent_style = space
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets}]
indent_size = 2

# ReSharper 品質門檻規則（CI inspectcode job 擋這些，見 .github/scripts/inspectcode-gate.py）。
# 設成 warning 只為了讓 Rider 顯示的等級與 CI 一致；CI 以規則清單判斷，不看這裡的 severity。
[*.cs]
resharper_unused_type_global_highlighting = warning
resharper_unused_member_local_highlighting = warning
resharper_unused_parameter_local_highlighting = warning
resharper_unused_variable_highlighting = warning
resharper_redundant_assignment_highlighting = warning
resharper_variable_hides_outer_variable_highlighting = warning
resharper_possible_multiple_enumeration_highlighting = warning
resharper_check_namespace_highlighting = warning
resharper_use_await_using_highlighting = warning
